<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electricity Bill Estimator"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Input 1: Month Selection Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Month:"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Input 2: kWh Unit Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electricity Unit Used (kWh) [1-1000]:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter kWh (e.g. 250)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- Input 3: Rebate Percentage Slider -->
        <TextView
            android:id="@+id/tvRebateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rebate Percentage: 0%"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarRebate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="0"
            android:layout_marginBottom="24dp" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CALCULATE BILL" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE RECORD TO DATABASE"
            android:layout_marginBottom="16dp" />

        <!-- Output Views -->
        <TextView
            android:id="@+id/tvTotalCharge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Charges: RM 0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvFinalCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Final Cost: RM 0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#008577"
            android:layout_marginBottom="24dp" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VIEW HISTORY"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAbout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ABOUT APP"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>